<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>uwb_driver</name>
  <version>1.0.0</version>
  <description>ROS 2 driver for UWB/UVDAR ranging modules over USB CDC-ACM (LLCP)</description>

  <maintainer email="vojnar@fly4future.com">Jan Vojnar</maintainer>
  <maintainer email="radomir.novy@fel.cvut.cz">Radomír Nový</maintainer>

  <author email="vojnar@fly4future.com">Jan Vojnar</author>

  <license>BSD 3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <build_depend>builtin_interfaces</build_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
